 "html": "<div class=\"cit-pod\">\n<style>\n.cit-pod{font-family:\"Noto Naskh Arabic\",\"Segoe UI\",Arial,sans-serif;font-size:11px;color:#16202e}\n.cit-pod table{width:100%;border-collapse:collapse}\n.cit-pod .hd{border-bottom:2px solid #1F3864;padding-bottom:8px;margin-bottom:12px}\n.cit-pod .hd td{vertical-align:top}\n.cit-pod .en{font-weight:600}\n.cit-pod .ar{font-size:10.5px;color:#5d6b7c;direction:rtl}\n.cit-pod h1{font-size:16px;margin:0;color:#1F3864}\n.cit-pod h1 small{display:block;font-size:12px;font-weight:400;direction:rtl}\n.cit-pod .grid td{border:1px solid #d7dde6;padding:5px 7px}\n.cit-pod .grid .lbl{background:#f6f8fb;width:22%}\n.cit-pod .items th{background:#1F3864;color:#fff;padding:5px 7px;font-size:10px;text-align:left}\n.cit-pod .items td{border:1px solid #d7dde6;padding:4px 7px}\n.cit-pod .num{text-align:right;direction:ltr}\n.cit-pod .sign{margin-top:16px}\n.cit-pod .sign td{border:1px solid #d7dde6;padding:8px;height:72px;vertical-align:top;width:50%}\n.cit-pod .note{margin-top:12px;font-size:9.5px;color:#5d6b7c;line-height:1.5}\n.cit-pod .seal-ok{color:#0F766E;font-weight:700}\n.cit-pod .seal-no{color:#b42318;font-weight:700}\n</style>\n\n<table class=\"hd\"><tr>\n\t<td>\n\t\t<h1>Proof of Delivery<small>\u0625\u062b\u0628\u0627\u062a \u0627\u0644\u062a\u0633\u0644\u064a\u0645</small></h1>\n\t\t<div style=\"margin-top:4px\">{{ doc.name }}</div>\n\t</td>\n\t<td style=\"text-align:right\">\n\t\t<div class=\"en\">{{ frappe.db.get_value(\"Company\", doc.company, \"company_name\") or doc.company }}</div>\n\t\t<div class=\"ar\">{{ frappe.db.get_value(\"Company\", doc.company, \"company_name_in_arabic\") or \"\" }}</div>\n\t\t<div style=\"margin-top:4px\">{{ frappe.utils.format_datetime(doc.pod_datetime) }}</div>\n\t</td>\n</tr></table>\n\n<table class=\"grid\">\n\t<tr>\n\t\t<td class=\"lbl\"><span class=\"en\">Customer</span><span class=\"ar\"> / \u0627\u0644\u0639\u0645\u064a\u0644</span></td>\n\t\t<td>{{ frappe.db.get_value(\"CIT Job\", doc.cit_job, \"customer\") }}</td>\n\t\t<td class=\"lbl\"><span class=\"en\">Trip</span><span class=\"ar\"> / \u0627\u0644\u0631\u062d\u0644\u0629</span></td>\n\t\t<td>{{ doc.cit_trip }}</td>\n\t</tr>\n\t<tr>\n\t\t<td class=\"lbl\"><span class=\"en\">Site</span><span class=\"ar\"> / \u0627\u0644\u0645\u0648\u0642\u0639</span></td>\n\t\t<td>{{ frappe.db.get_value(\"Customer Site\", doc.customer_site, \"site_name\") or doc.customer_site }}</td>\n\t\t<td class=\"lbl\"><span class=\"en\">Type</span><span class=\"ar\"> / \u0627\u0644\u0646\u0648\u0639</span></td>\n\t\t<td>{{ _(doc.pod_type) }}</td>\n\t</tr>\n\t<tr>\n\t\t<td class=\"lbl\"><span class=\"en\">Vehicle</span><span class=\"ar\"> / \u0627\u0644\u0645\u0631\u0643\u0628\u0629</span></td>\n\t\t<td>{{ frappe.db.get_value(\"CIT Trip\", doc.cit_trip, \"vehicle\") }}</td>\n\t\t<td class=\"lbl\"><span class=\"en\">Position</span><span class=\"ar\"> / \u0627\u0644\u0645\u0648\u0642\u0639 \u0627\u0644\u062c\u063a\u0631\u0627\u0641\u064a</span></td>\n\t\t<td class=\"num\">{{ \"%.5f\"|format(doc.latitude or 0) }}, {{ \"%.5f\"|format(doc.longitude or 0) }}</td>\n\t</tr>\n</table>\n\n<table class=\"items\" style=\"margin-top:12px\">\n\t<thead><tr>\n\t\t<th style=\"width:6%\">#</th>\n\t\t<th style=\"width:30%\">Bag / \u0627\u0644\u0643\u064a\u0633</th>\n\t\t<th style=\"width:26%\">Seal / \u0627\u0644\u062e\u062a\u0645</th>\n\t\t<th style=\"width:22%\" class=\"num\">Declared / \u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0635\u0631\u0651\u062d \u0628\u0647</th>\n\t\t<th style=\"width:16%\">Seal state / \u062d\u0627\u0644\u0629 \u0627\u0644\u062e\u062a\u0645</th>\n\t</tr></thead>\n\t<tbody>\n\t{% for b in doc.bags %}\n\t\t<tr>\n\t\t\t<td>{{ loop.index }}</td>\n\t\t\t<td>{{ frappe.db.get_value(\"Cash Bag\", b.cash_bag, \"bag_no\") or b.cash_bag }}</td>\n\t\t\t<td>{{ b.seal_no or \"\u2014\" }}</td>\n\t\t\t<td class=\"num\">{{ frappe.utils.fmt_money(b.declared_amount, currency=b.currency or \"SAR\") }}</td>\n\t\t\t<td>{% if b.seal_intact %}<span class=\"seal-ok\">Intact / \u0633\u0644\u064a\u0645</span>\n\t\t\t    {% else %}<span class=\"seal-no\">Broken / \u0645\u0643\u0633\u0648\u0631</span>{% endif %}</td>\n\t\t</tr>\n\t{% endfor %}\n\t\t<tr>\n\t\t\t<td colspan=\"3\" style=\"text-align:right;font-weight:600\">Total / \u0627\u0644\u0625\u062c\u0645\u0627\u0644\u064a</td>\n\t\t\t<td class=\"num\" style=\"font-weight:600\">{{ frappe.utils.fmt_money(doc.total_declared, currency=\"SAR\") }}</td>\n\t\t\t<td>{{ doc.bags|length }} bag(s) / \u0643\u064a\u0633</td>\n\t\t</tr>\n\t</tbody>\n</table>\n\n<table class=\"sign\"><tr>\n\t<td>\n\t\t<div class=\"en\">Handed over by \u2014 crew</div>\n\t\t<div class=\"ar\">\u0633\u0644\u0651\u0645\u0647 \u2014 \u0627\u0644\u0637\u0627\u0642\u0645</div>\n\t\t<div style=\"margin-top:6px\">{{ frappe.db.get_value(\"Employee\", doc.captured_by, \"employee_name\") or \"\" }}</div>\n\t</td>\n\t<td>\n\t\t<div class=\"en\">Received by \u2014 customer</div>\n\t\t<div class=\"ar\">\u0627\u0633\u062a\u0644\u0645\u0647 \u2014 \u0627\u0644\u0639\u0645\u064a\u0644</div>\n\t\t<div style=\"margin-top:6px\">{{ doc.signatory_name or \"\" }}\n\t\t\t{% if doc.signatory_id %}<br><span style=\"color:#5d6b7c\">ID / \u0627\u0644\u0647\u0648\u064a\u0629: {{ doc.signatory_id }}</span>{% endif %}\n\t\t\t{% if doc.signatory_designation %}<br><span style=\"color:#5d6b7c\">{{ doc.signatory_designation }}</span>{% endif %}\n\t\t</div>\n\t\t{% if doc.signature %}<img src=\"{{ doc.signature }}\" style=\"max-height:44px;margin-top:4px\">{% endif %}\n\t\t{% if doc.otp_verified %}<div style=\"color:#0F766E;margin-top:4px\">Verified by one-time code / \u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0628\u0631\u0645\u0632 \u0645\u0624\u0642\u062a</div>{% endif %}\n\t</td>\n</tr></table>\n\n<div class=\"note\">\n\tThis document records a transfer of custody. It is generated from the system and cannot be\n\taltered after submission.<br>\n\t<span style=\"direction:rtl;display:inline-block\">\u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0646\u062f \u064a\u0648\u062b\u0651\u0642 \u0646\u0642\u0644 \u0627\u0644\u0639\u0647\u062f\u0629\u060c \u0648\u0647\u0648 \u0635\u0627\u062f\u0631 \u0645\u0646 \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0639\u062f\u064a\u0644\u0647 \u0628\u0639\u062f \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f.</span>\n</div>\n</div>\n",
